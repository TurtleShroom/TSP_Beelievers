					<!-- <label>Yuran Bee</label> -->
					<description>Yuran Bees are special Oriental Bees exposed to the mystic crafts of the Yuran race. Yuran Bees are magically enhanced by Yuran spells to produce Yuran products, albeit at a slow clip. They produce various Yuran goods in the process of pollinating Yuran plants. \n\n\n\n\n Bee Traits: \n\n 	Production time: 5 days \n 	Works at Night: No \n 	Works When Raining: No \n 	Unusual Sources Needed: No \n 	Minimum Temperature: -6ºF (-21.1111ºC) \n 	Maximum temperature: 112ºF (-41.4444ºC)</description>
					<!--
					<graphicData Inherit="False">
						<texPath>Things/Pawn/Animal/Bug_Types/Bee/ST_Bee_south</texPath>
						<graphicClass>Graphic_Single</graphicClass>
					</graphicData>
					-->
					<comps>			
						<li Class="RimBees.CompProperties_Bees" Inherit="False">
							<species>Yuran</species>
							<comb>TSP_RB_Beeliever_Yuran_Honeycomb</comb>
							<combtimedays>5</combtimedays>
							<nocturnal>false</nocturnal> <!-- Works at night -->
							<pluviophile>true</pluviophile> <!-- Works in the rain -->
							<weirdplantneeded>no</weirdplantneeded>
							<tempMin>-21</tempMin> <!-- Negative six degrees -->
							<tempMax>44</tempMax> <!-- One hundred twelve degrees -->
						</li>   
					</comps>
				</ThingDef>
				
				<!-- MUST be RB_Bee_YOURNAME_Queen and then RB_Bee_YOURNAME_Drone, no exceptions -->
