					</graphicData>	
					<thingCategories Inherit="False">
						<li>TSP_RB_Beeliever_Honeycombs</li>
					</thingCategories>
					<butcherProducts>
						<TSP_RB_Beelievers_Yuran_SpawnSystem>1</TSP_RB_Beelievers_Yuran_SpawnSystem>
						<RB_RedBeeswax>10</RB_RedBeeswax>
						<RB_AdaptiveHoney>5</RB_AdaptiveHoney>
					</butcherProducts>
				</ThingDef>
				
				<RecipeDef>
					<defName>TSP_RB_Beeliever_Centrifuge_Yuran_Honeycomb</defName>
					<label>Extract from Yuran Bee honeycomb</label>
					<description>Exract Yuran products from Yuran Bee honeycombs! Yuran Bees are magically enhanced by Yuran spells to produce Yuran products, albeit at a slow clip.</description>
					<descriptionHyperlinks>
						<ThingDef>RB_Bee_Yuran_Queen</ThingDef>
						<ThingDef>RB_Bee_Yuran_Drone</ThingDef>
						<ThingDef>TSP_RB_Beeliever_Yuran_Honeycomb</ThingDef>
						<!-- <RecipeDef>TSP_RB_Beeliever_Centrifuge_Yuran_Honeycomb</RecipeDef> -->
						<ThingDef MayRequire="vanillaexpanded.vplantse">VCE_RawYuran</ThingDef>
						<ThingDef MayRequire="rooandgloomy.yuranracemod">YR_yedoensisBerries</ThingDef>
						<ThingDef MayRequire="tsp.zal.patchhoney2">TSP_LaymanHoneyMachine</ThingDef>
					</descriptionHyperlinks>
					<uiIconThing>TSP_RB_Beelievers_Yuran_SpawnSystem</uiIconThing>
