					<defName>RB_Bee_Yuran_Queen</defName>
					<label>Yuran Bee queen</label>
					<descriptionHyperlinks>
						<!-- <ThingDef>RB_Bee_Yuran_Queen</ThingDef> -->
						<ThingDef>RB_Bee_Yuran_Drone</ThingDef>
						<ThingDef>TSP_RB_Beeliever_Yuran_Honeycomb</ThingDef>
						<RecipeDef>TSP_RB_Beeliever_Centrifuge_Yuran_Honeycomb</RecipeDef>
						<ThingDef MayRequire="vanillaexpanded.vplantse">VCE_RawYuran</ThingDef>
						<ThingDef MayRequire="rooandgloomy.yuranracemod">YR_yedoensisBerries</ThingDef>
						<ThingDef MayRequire="tsp.zal.patchhoney2">TSP_LaymanHoneyMachine</ThingDef>
					</descriptionHyperlinks>
					<graphicData Inherit="False">
						<texPath>Things/Pawn/Animal/Bug_Types/Bee/SlurryBranch/RB_Bee_NoxiousCherry_Yuran_Queen</texPath>
						<graphicClass>Graphic_Single</graphicClass>
						<color>(137,20,59)</color>
					</graphicData> 		
				</ThingDef>
				
				<ThingDef ParentName="TSP_RB_Beeliever_Yuran_Base">
					<defName>RB_Bee_Yuran_Drone</defName>
					<label>Yuran Bee drone</label>
					<descriptionHyperlinks>
						<ThingDef>RB_Bee_Yuran_Queen</ThingDef>
						<!-- <ThingDef>RB_Bee_Yuran_Drone</ThingDef> -->
						<ThingDef>TSP_RB_Beeliever_Yuran_Honeycomb</ThingDef>
						<RecipeDef>TSP_RB_Beeliever_Centrifuge_Yuran_Honeycomb</RecipeDef>
						<ThingDef MayRequire="vanillaexpanded.vplantse">VCE_RawYuran</ThingDef>
