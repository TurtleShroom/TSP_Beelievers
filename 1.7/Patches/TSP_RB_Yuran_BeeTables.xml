<?xml version="1.0" encoding="utf-8" ?>

<Patch>
	<Operation Class="PatchOperationFindMod">
	<!-- Do any of the following Mods exist? -->
		<mods>
			<li>Yuran race</li>
			<li>悠兰纸人诱饵但是啥杯</li>
			<li>Vanilla Plants Expanded</li>
		</mods>
		<match Class="PatchOperationAdd">
			<xpath>/Defs</xpath>
			<success>Always</success>
			<value>
				<!-- Cherry Branch -->
				<!-- TIER Cherry -->
				<!-- BEE DESCRIPTION -->
				<RimBees.BeeListDef>
					<defName>TSP_RB_Beeliever_Cherry</defName>
					<nameString>Cherry</nameString>
					<beeDroneDef>RB_Bee_Cherry_Drone</beeDroneDef>
					<beeQueenDef>RB_Bee_Cherry_Queen</beeQueenDef>
					<!--
					<beeQueenTag>RB_Bee_Cherry_Queen_Tag</beeQueenTag>
					<beeDroneTag>RB_Bee_Cherry_Drone_Tag</beeDroneTag>
					-->
				</RimBees.BeeListDef>
				
				<RimBees.BeeCombinationDef>
					<defName>TSP_RB_Beelievers_Yuran1_Tables</defName>
					<bee1>Fruit</bee1>
					<bee2>Slurry</bee2>
					<result>
						<li>Cherry</li>
					</result>				
				</RimBees.BeeCombinationDef>
			
				<ThingDef ParentName="TSP_RB_Beeliever_MasterBeeBase" Name="TSP_RB_Beeliever_Cherry_Base" Abstract="True">
					<!-- <label>Cherry Bee</label> -->
					<description>I HATE CHERRIES!!! Eww. EWW. Oh gosh, EWW EWW EWW! IT TASTES LIKE MEDICINE! AWW! GROSS! WHO EATS THIS CRAP?! \n\n\n\n\n Bee Traits: \n\n 	Production time: 1 day \n 	Works at Night: No \n 	Works When Raining: No \n 	Unusual Sources Needed: No \n 	Minimum Temperature: 0ºF (-17.7778ºC) \n 	Maximum temperature: 97ºF (36.1111ºC)</description>
					<!--
					<graphicData Inherit="False">
						<texPath>Things/Pawn/Animal/Bug_Types/Bee/ST_Bee_south</texPath>
						<graphicClass>Graphic_Single</graphicClass>
					</graphicData>
					-->
					<comps>			
						<li Class="RimBees.CompProperties_Bees" Inherit="False">
							<species>Cherry</species>
							<comb>TSP_RB_Beeliever_Cherry_Honeycomb</comb>
							<combtimedays>1</combtimedays>
							<nocturnal>false</nocturnal> <!-- Works at night -->
							<pluviophile>true</pluviophile> <!-- Works in the rain -->
							<weirdplantneeded>no</weirdplantneeded>
							<tempMin>-18</tempMin> <!-- Zero degrees -->
							<tempMax>37</tempMax> <!-- Ninety-seven degrees -->
						</li>   
					</comps>
				</ThingDef>
				
				<!-- MUST be RB_Bee_YOURNAME_Queen and then RB_Bee_YOURNAME_Drone, no exceptions -->
				<ThingDef ParentName="TSP_RB_Beeliever_Cherry_Base">
					<defName>RB_Bee_Cherry_Queen</defName>
					<label>Cherry Bee queen</label>
					<descriptionHyperlinks>
						<!-- <ThingDef>RB_Bee_Cherry_Queen</ThingDef> -->
						<ThingDef>RB_Bee_Cherry_Drone</ThingDef>
						<ThingDef>TSP_RB_Beeliever_Cherry_Honeycomb</ThingDef>
						<RecipeDef>TSP_RB_Beeliever_Centrifuge_Cherry_Honeycomb</RecipeDef>
						<ThingDef MayRequire="vanillaexpanded.vplantse">VCE_RawCherry</ThingDef>
						<ThingDef MayRequire="rooandgloomy.yuranracemod">YR_yedoensisBerries</ThingDef>
						<ThingDef MayRequire="tsp.zal.patchhoney2">TSP_LaymanHoneyMachine</ThingDef>
					</descriptionHyperlinks>
					<graphicData Inherit="False">
						<texPath>Things/Pawn/Animal/Bug_Types/Bee/SlurryBranch/RB_Bee_NoxiousCherry_Queen</texPath>
						<graphicClass>Graphic_Single</graphicClass>
						<color>(137,20,59)</color>
					</graphicData> 		
				</ThingDef>
				
				<ThingDef ParentName="TSP_RB_Beeliever_Cherry_Base">
					<defName>RB_Bee_Cherry_Drone</defName>
					<label>Cherry Bee drone</label>
					<descriptionHyperlinks>
						<ThingDef>RB_Bee_Cherry_Queen</ThingDef>
						<!-- <ThingDef>RB_Bee_Cherry_Drone</ThingDef> -->
						<ThingDef>TSP_RB_Beeliever_Cherry_Honeycomb</ThingDef>
						<RecipeDef>TSP_RB_Beeliever_Centrifuge_Cherry_Honeycomb</RecipeDef>
						<ThingDef MayRequire="vanillaexpanded.vplantse">VCE_RawCherry</ThingDef>
						<ThingDef MayRequire="rooandgloomy.yuranracemod">YR_yedoensisBerries</ThingDef>
						<ThingDef MayRequire="tsp.zal.patchhoney2">TSP_LaymanHoneyMachine</ThingDef>
					</descriptionHyperlinks>
					<graphicData Inherit="False">
						<texPath>Things/Pawn/Animal/Bug_Types/Bee/SlurryBranch/RB_Bee_NoxiousCherry_Drone</texPath>
						<graphicClass>Graphic_Single</graphicClass>
						<color>(137,20,59)</color>
					</graphicData> 		
				</ThingDef>
				
				<ThingDef ParentName="RB_CombBase">
					<defName>TSP_RB_Beeliever_Cherry_Honeycomb</defName>
					<label>Cherry Bee honeycomb</label>
					<description>Absolutely disgusting. Get cherries, Red Beeswax, and Psychotropic Honey... but why would you want cherries?</description>
					<descriptionHyperlinks>
						<ThingDef>RB_Bee_Cherry_Queen</ThingDef>
						<ThingDef>RB_Bee_Cherry_Drone</ThingDef>
						<!-- <ThingDef>TSP_RB_Beeliever_Cherry_Honeycomb</ThingDef> -->
						<RecipeDef>TSP_RB_Beeliever_Centrifuge_Cherry_Honeycomb</RecipeDef>
						<ThingDef MayRequire="vanillaexpanded.vplantse">VCE_RawCherry</ThingDef>
						<ThingDef MayRequire="rooandgloomy.yuranracemod">YR_yedoensisBerries</ThingDef>
						<ThingDef MayRequire="tsp.zal.patchhoney2">TSP_LaymanHoneyMachine</ThingDef>
					</descriptionHyperlinks>
					<graphicData Inherit="False">
						<texPath>Things/Pawn/Animal/Bug_Types/Bee/Honeycombs/TSB_RB_IHATECHERRIES</texPath>
						<graphicClass>Graphic_Single</graphicClass>
						<color>(137,20,59)</color>
					</graphicData>	
					<thingCategories Inherit="False">
						<li>TSP_RB_Beeliever_Honeycombs</li>
					</thingCategories>
					<butcherProducts>
						<VCE_RawCherry MayRequire="vanillaexpanded.vplantse">15</VCE_RawCherry>
						<YR_yedoensisBerries MayRequire="rooandgloomy.yuranracemod">10</YR_yedoensisBerries>
						<RB_RedBeeswax>5</RB_RedBeeswax>
						<RB_PsychotropicHoney>5</RB_PsychotropicHoney>
					</butcherProducts>
				</ThingDef>
				
				<RecipeDef>
					<defName>TSP_RB_Beeliever_Centrifuge_Cherry_Honeycomb</defName>
					<label>Extract from Cherry Bee honeycomb</label>
					<description>EWW!</description>
					<descriptionHyperlinks>
						<ThingDef>RB_Bee_Cherry_Queen</ThingDef>
						<ThingDef>RB_Bee_Cherry_Drone</ThingDef>
						<ThingDef>TSP_RB_Beeliever_Cherry_Honeycomb</ThingDef>
						<!-- <RecipeDef>TSP_RB_Beeliever_Centrifuge_Cherry_Honeycomb</RecipeDef> -->
						<ThingDef MayRequire="vanillaexpanded.vplantse">VCE_RawCherry</ThingDef>
						<ThingDef MayRequire="rooandgloomy.yuranracemod">YR_yedoensisBerries</ThingDef>
						<ThingDef MayRequire="tsp.zal.patchhoney2">TSP_LaymanHoneyMachine</ThingDef>
					</descriptionHyperlinks>
					<!-- <uiIconThing></uiIconThing> -->
					<jobString>Eww.</jobString>
					<effectWorking>Cremate</effectWorking>
					<soundWorking>Recipe_Cremate</soundWorking>
					<workAmount>900</workAmount>
					<recipeUsers Inherit="False"></recipeUsers>	
					<ingredients>
						<li>
							<filter>
								<thingDefs>
									<li>TSP_RB_Beeliever_Cherry_Honeycomb</li>
								</thingDefs>
							</filter>
							<count>1</count>
						</li>
					</ingredients>
					<fixedIngredientFilter>
						<thingDefs>
							<li>TSP_RB_Beeliever_Cherry_Honeycomb</li>
						</thingDefs>
					</fixedIngredientFilter>
					<specialProducts>
						<li>Butchery</li>
					</specialProducts>
					<skillRequirements></skillRequirements>
					<researchPrerequisites></researchPrerequisites>
				</RecipeDef>
			</value>
		</match>
	</Operation>
	
	
	<Operation Class="PatchOperationConditional">
	<!-- Does this exist? -->
		<xpath>Defs/ThingDef[defName="YR_yedoensisBerries_Big"]</xpath>
		<match Class="PatchOperationAdd">
			<xpath>/Defs</xpath>
			<success>Always</success>
			<value>
				<!-- Yuran Branch -->
				<!-- TIER Yuran -->
				<!-- BEE DESCRIPTION -->
				<RimBees.BeeListDef>
					<defName>TSP_RB_Beeliever_Yuran</defName>
					<nameString>Yuran</nameString>
					<beeDroneDef>RB_Bee_Yuran_Drone</beeDroneDef>
