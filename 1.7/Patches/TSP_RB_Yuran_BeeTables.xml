						<graphicClass>Graphic_Single</graphicClass>
						<color>(137,20,59)</color>
					</graphicData>
				</ThingDef>
				
				<ThingDef ParentName="RB_CombBase">
					<defName>TSP_RB_Beeliever_Yuran_Honeycomb</defName>
					<label>Yuran Bee honeycomb</label>
					<description>Yuran Bees are magically enhanced by Yuran spells to produce Yuran products, albeit at a slow clip. Yurans cultivate these special bees to better produce their distinct cultural products and goods. All Yuran Bees produce Red Beeswax and Adaptive Honey, but what else they generate depends on when their hives are harvested.</description>
					<descriptionHyperlinks>
						<ThingDef>RB_Bee_Yuran_Queen</ThingDef>
						<ThingDef>RB_Bee_Yuran_Drone</ThingDef>
						<!-- <ThingDef>TSP_RB_Beeliever_Yuran_Honeycomb</ThingDef> -->
						<RecipeDef>TSP_RB_Beeliever_Centrifuge_Yuran_Honeycomb</RecipeDef>
						<ThingDef MayRequire="vanillaexpanded.vplantse">VCE_RawYuran</ThingDef>
						<ThingDef MayRequire="rooandgloomy.yuranracemod">YR_yedoensisBerries</ThingDef>
						<ThingDef MayRequire="tsp.zal.patchhoney2">TSP_LaymanHoneyMachine</ThingDef>
					</descriptionHyperlinks>
