<?xml version="1.0" encoding="utf-8" ?>

<Patch>
	<Operation Class="PatchOperationConditional">
	<!-- Does this exist? -->
		<xpath>Defs/ThingDef[@Name="RB_FrigidBeeBase"]/comps/li/heatPushMaxTemperature</xpath>
		<!-- If it does, do this replacement. -->
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[@Name="RB_FrigidBeeBase"]/comps/li/heatPushMaxTemperature</xpath>
			<success>Always</success>
			<value>
				<heatPushMaxTemperature>80</heatPushMaxTemperature>
			</value>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. -->
	</Operation>
	
	<Operation Class="PatchOperationConditional">
	<!-- Does this exist? -->
		<xpath>Defs/ThingDef[@Name="RB_FrigidBeeBase"]/comps/li/heatPerSecond</xpath>
		<!-- If it does, do this replacement. -->
		<match Class="PatchOperationReplace">
			<xpath>Defs/ThingDef[@Name="RB_FrigidBeeBase"]/comps/li/heatPerSecond</xpath>
			<success>Always</success>
			<value>
				<heatPerSecond>-30</heatPerSecond>
			</value>
		</match>
		<!-- If the first XPATH does not exist, the original code stands. -->
	</Operation>
</Patch>